# Discord Bot Configuration
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_client_id
DISCORD_CLIENT_SECRET=your_client_secret
DISCORD_REDIRECT_URI=https://your-domain.com/callback

# Server Configuration (optional)
GUILD_ID=optional_server_id
ALLOWED_USER_IDS=user1,user2,user3

# Dashboard Configuration
DASHBOARD_URL=https://your-domain.com
DASHBOARD_SECRET=generate_a_random_secret_key_here
COOKIE_SECURE=1

# Data Storage
DATA_FILE=/data/vouches.json

# API Configuration
API_PORT=5000
API_HOST=0.0.0.0

# Logging
LOG_LEVEL=INFO
LOG_FILE=./bot.log

# Optional: AI Chat Features
NVIDIA_API_KEY=your_nvidia_api_key_for_chat
NVIDIA_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1.5

# Optional: Monitoring & Metrics
SENTRY_DSN=optional_sentry_dsn
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=8000

# Optional: Advanced Features
ENABLE_CACHING=true
CACHE_BACKEND=redis
REDIS_URL=redis://localhost:6379/0
ENABLE_RATE_LIMITING=true
RATE_LIMIT_REQUESTS_PER_MINUTE=100

# Environment
ENVIRONMENT=development
DEBUG=false
